{
  "version": 2,
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "env": {
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp/views"
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/api/check-latest-attendance",
      "dest": "/api/index.php?route=check-latest-attendance"
    },
    {
      "src": "/api/check-latest-assignment",
      "dest": "/api/index.php?route=check-latest-assignment"
    },
    {
      "src": "/api/attendance-scan",
      "dest": "/api/index.php?route=attendance-scan"
    },
    {
      "src": "/api/rfid-scan",
      "dest": "/api/index.php?route=rfid-scan"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php?route=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php?path=$1"
    }
  ]
}